# Leave VITE_API_URL unset for local development; Vite proxies /api, /health,
# and /socket.io to http://localhost:3001.
#
# For a deployed frontend, set this at build time to the public backend origin:
# VITE_API_URL=https://tempass-server.onrender.com
VITE_API_URL=

# Optional ICE servers, as a JSON array. Without this the client only uses
# public STUN, which is enough on most home networks but stalls behind strict
# NATs and corporate firewalls. Add a TURN server to make tab sharing reliable:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
VITE_ICE_SERVERS=
