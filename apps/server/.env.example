# Tempass server configuration
# Copy this file to .env for local development. Do not commit .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Production deployments must use HTTPS origins and a non-localhost hostname.
# Set HOST=0.0.0.0 when the platform routes traffic to the container.

# Room lifecycle
MAX_PARTICIPANTS=2
RECONNECT_GRACE_MS=30000
EMPTY_ROOM_TTL_MS=300000
ROOM_MAX_AGE_MS=43200000
CLEANUP_INTERVAL_MS=30000
