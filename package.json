{
  "name": "tempass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, YouTube-only synchronized watch parties for two people.",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @tempass/server",
    "dev:web": "npm run dev --workspace @tempass/web",
    "build": "npm run typecheck && npm run build --workspace @tempass/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:server": "npm run start --workspace @tempass/server"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
